{
  "name": "@karat/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "build": "nest build && npm run openapi",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "openapi": "node dist/emit-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.3",
    "@types/node": "22.15.3",
    "prisma": "7.9.1",
    "tsx": "4.23.12"
  }
}
