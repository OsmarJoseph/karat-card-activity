{
  "openapi": "3.0.0",
  "paths": {
    "/activity": {
      "get": {
        "operationId": "getActivity",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "type": "integer"
            }
          },
          {
            "name": "kind",
            "required": false,
            "in": "query",
            "schema": {
              "default": "all",
              "type": "string",
              "enum": [
                "all",
                "pending",
                "settled"
              ]
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "food_drink",
                "groceries",
                "shopping",
                "transport",
                "travel",
                "entertainment",
                "software",
                "utilities",
                "health",
                "professional_services",
                "fees",
                "other"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityPage_Output"
                }
              }
            }
          }
        },
        "tags": [
          "Activity"
        ]
      }
    },
    "/insights": {
      "get": {
        "operationId": "getInsights",
        "parameters": [
          {
            "name": "period",
            "required": false,
            "in": "query",
            "schema": {
              "default": "current_month",
              "type": "string",
              "enum": [
                "current_month",
                "last_30d",
                "last_90d"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Insights_Output"
                }
              }
            }
          }
        },
        "tags": [
          "Insights"
        ]
      }
    }
  },
  "info": {
    "title": "Karat card activity",
    "description": "Card activity and spend insights for one Stripe Issuing cardholder.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "ActivityItem_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "authorization",
              "transaction"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "settled"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "capture",
              "refund",
              null
            ],
            "nullable": true
          },
          "amount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string"
          },
          "formattedAmount": {
            "type": "string"
          },
          "merchantName": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "food_drink",
              "groceries",
              "shopping",
              "transport",
              "travel",
              "entertainment",
              "software",
              "utilities",
              "health",
              "professional_services",
              "fees",
              "other"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "type",
          "amount",
          "currency",
          "formattedAmount",
          "merchantName",
          "category",
          "occurredAt"
        ],
        "additionalProperties": false
      },
      "ActivityPage_Output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityItem_Output"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "hasMore"
        ],
        "additionalProperties": false
      },
      "InsightsPeriod_Output": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "label"
        ],
        "additionalProperties": false
      },
      "InsightsMetrics_Output": {
        "type": "object",
        "properties": {
          "settledSpend": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "transactionCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "averageTransaction": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "previousPeriodSettledSpend": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "changePercent": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "settledSpend",
          "transactionCount",
          "averageTransaction",
          "previousPeriodSettledSpend",
          "changePercent"
        ],
        "additionalProperties": false
      },
      "PendingTotals_Output": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "amount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "count",
          "amount"
        ],
        "additionalProperties": false
      },
      "SpendBreakdownItem_Output": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "food_drink",
              "groceries",
              "shopping",
              "transport",
              "travel",
              "entertainment",
              "software",
              "utilities",
              "health",
              "professional_services",
              "fees",
              "other"
            ]
          },
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "percent": {
            "type": "number"
          },
          "count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "category",
          "label",
          "amount",
          "percent",
          "count"
        ],
        "additionalProperties": false
      },
      "Insights_Output": {
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/InsightsPeriod_Output"
          },
          "metrics": {
            "$ref": "#/components/schemas/InsightsMetrics_Output"
          },
          "pending": {
            "$ref": "#/components/schemas/PendingTotals_Output"
          },
          "breakdown": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpendBreakdownItem_Output"
            }
          }
        },
        "required": [
          "period",
          "metrics",
          "pending",
          "breakdown"
        ],
        "additionalProperties": false
      }
    }
  }
}
