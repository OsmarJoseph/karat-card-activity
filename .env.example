# Copy to .env and fill in the Stripe values. Everything else works as-is
# against the Postgres in docker-compose.yml.

# Postgres. Host port 5433, matching docker-compose.yml.
DATABASE_URL="postgresql://karat:karat@localhost:5433/karat_card_activity?schema=public"

# API
NODE_ENV=development
PORT=3000
# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173

# Stripe Issuing. A sandbox secret key with Issuing enabled.
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed once by:
#   stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# The one cardholder this deployment serves. There is no login in v1, so the
# identity that would come from a session comes from here instead.
CARDHOLDER_STRIPE_ID=ich_replace_me

# Web. Vite only exposes VITE_-prefixed variables to the browser, and inlines
# them at build time rather than reading them at runtime.
VITE_API_BASE_URL=http://localhost:3000/api/v1
