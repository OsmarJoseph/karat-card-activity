# Copy to .env. The placeholders below are enough to run everything, including
# npm run webhook:seed, because that signs its payloads with the same secret the
# API verifies them against. Replace them only to point at a real Stripe account.

# Postgres. Host port 5433, matching docker-compose.yml.
DATABASE_URL="postgresql://karat:karat@localhost:5433/karat_card_activity?schema=public"

# API
NODE_ENV=development
PORT=3000
# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173

# Stripe Issuing. Only used to look up a card an event did not carry, which the
# local webhooks always do carry, so the placeholder is never dereferenced.
STRIPE_SECRET_KEY=sk_test_replace_me
# The shared secret webhook signatures are checked against. Any value works
# locally. Against a real account, the one `stripe listen` prints.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# The one cardholder this deployment serves. There is no login in v1, so the
# identity that would come from a session comes from here instead.
CARDHOLDER_STRIPE_ID=ich_replace_me

# Web. Vite only exposes VITE_-prefixed variables to the browser, and inlines
# them at build time rather than reading them at runtime.
VITE_API_BASE_URL=http://localhost:3000/api/v1
